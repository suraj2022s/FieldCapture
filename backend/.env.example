# Copy to backend/.env (gitignored) and fill in.
ANTHROPIC_API_KEY=

# Where uploads, the SQLite db and job records are written.
FIELDCAPTURE_DATA_DIR=data

# Models per task (benchmarked in eval/: Haiku 5.5 vs Sonnet 5.5 vs Opus 5.5).
FIELDCAPTURE_MODEL_NAMEPLATE=claude-opus-5-5
FIELDCAPTURE_MODEL_DAMAGE=claude-opus-5-5
FIELDCAPTURE_MODEL_NOTE=claude-haiku-5-5

# Set to 0 to store uploads without calling the model (offline back office / tests).
FIELDCAPTURE_EXTRACT=1
