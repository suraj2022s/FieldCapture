# --- Secrets & local-only files ---
.claude/settings.local.json
# Google's official Android skills, installed locally (see CLAUDE.md "Tools used" for how to reinstall)
.claude/skills/
.env
.env.*
!.env.example
local.properties
*.keystore
*.jks
secrets/
private/

# --- Android / Gradle / IntelliJ ---
.gradle/
**/build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.iml
.idea/
.kotlin/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
# Schemathesis fuzzing cache (README "Without a phone")
.schemathesis/
# mutmut's results cache and its copy of the file it is mutating
.mutmut-cache
*.py.bak

# --- Backend runtime data (job uploads, sqlite) ---
backend/data/

# --- Eval scratch (results that matter are committed explicitly) ---
eval/.cache/
# Raw pulls from the phone (every candidate frame). The curated, labelled test set lives in eval/dataset/.
eval/raw/

# --- OS / editors ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
